{
  // The app's tsconfig deliberately keeps `types` browser-only. The end-to-end
  // suite is Node code that drives a browser, so it gets its own config rather
  // than widening the app's type environment.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": false,
    "types": ["node"]
  },
  // `uxr` is the same kind of code — Node driving a browser, on the e2e
  // fixtures — so it types against the same environment rather than the app's.
  "include": ["e2e", "playwright.config.ts", "uxr"],
  // Except the files under `uxr` that are not Node: the harness entries that
  // mount the real components are browser React with the app's aliases, and
  // type against the app's project instead. Their shooters stay here.
  "exclude": [
    "uxr/kiosk-live/main.tsx",
    "uxr/kiosk-reprint/main.tsx",
    "uxr/kiosk-setup-live/main.tsx",
    "uxr/kiosk-setup-live/scene.tsx",
    "uxr/kiosk-setup-live/stubs.tsx",
    "uxr/team-live/main.tsx",
    "uxr/team-live/stubs.tsx",
    "uxr/team-live/fixture.ts",
    "uxr/review-live/main.tsx",
    "uxr/review-live/Toast.tsx",
    "uxr/review-live/stubs.tsx",
    "uxr/review-live/fixture.ts"
  ]
}
