{
  // The app's tsconfig deliberately keeps `types` browser-only. The end-to-end
  // suite is Node code that drives a browser, so it gets its own config rather
  // than widening the app's type environment.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": false,
    "types": ["node"]
  },
  // `uxr` is the same kind of code — Node driving a browser, on the e2e
  // fixtures — so it types against the same environment rather than the app's.
  "include": ["e2e", "playwright.config.ts", "uxr"],
  // Except the one file under `uxr` that is not Node: the kiosk harness entry
  // mounts the real components, so it is browser React with the app's aliases
  // and types against the app's project instead.
  "exclude": ["uxr/kiosk-live/main.tsx"]
}
