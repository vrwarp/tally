# Copy to `.env.local` and fill in from the Firebase console
# (Project settings -> General -> Your apps -> Web app config).
#
# The whole config object goes in one variable, on one line. The console prints
# it as `const firebaseConfig = { ... }`; take the object part. JSON wants
# double-quoted keys, which the console's JavaScript form does not use.
#
# These values are NOT secrets: a Firebase web config is shipped to every
# browser by design. Access control lives in firestore.rules, not here.

VITE_FIREBASE_CONFIG={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":""}

# Set to "true" to point the app at the local Firebase Emulator Suite, which
# needs no config above at all. `npm run dev:emulated` sets this for you.
VITE_USE_EMULATORS=false

# Emulator hosts/ports — only read when VITE_USE_EMULATORS=true.
# Defaults match firebase.json, so you normally do not need to set these.
VITE_EMULATOR_HOST=127.0.0.1
VITE_EMULATOR_AUTH_PORT=9099
VITE_EMULATOR_FIRESTORE_PORT=8080
