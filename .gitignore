node_modules/
dist/
dist-ssr/
*.local

# Local env — never commit real Firebase config or API keys.
.env
.env.*
!.env.example
!.env.emulated

# Planning Center credentials for the local functions emulator.
# `.env.demo-tally` is deliberately NOT ignored: it holds only simulator
# settings for the emulator-only `demo-` project namespace. The negation has to
# be spelled out — `.env.*` above matches at every level, so without this line
# the file was ignored despite this comment, and no clone or CI checkout has ever
# had it. The Functions emulator then stops to prompt for the params it declares,
# loads nothing, and every end-to-end sign-in fails on a 404 from
# `provisionAccess`.
!functions/.env.demo-tally
functions/.secret.local
functions/.env
functions/.env.local
functions/lib/

# Firebase
.firebase/
.emulator-data/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
*-debug.log

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Test output
coverage/

# Walkthrough build products.
#
# `docs/walkthrough/web/*.jpg` IS committed — it is what the Markdown shows and
# it is only ~700 kB. These two are not: the PNGs are 4 MB of archival
# originals, and the HTML page is another megabyte of the same images inlined as
# base64. Both regenerate with `npm run walkthrough`.
docs/walkthrough/shots/
docs/walkthrough/walkthrough.html
docs/walkthrough/parents/shots/
docs/walkthrough/parents/index.html

# Playwright output — regenerated by every run.
playwright-report/
test-results/
blob-report/
tsconfig.tsbuildinfo

# UXR refinement working files.
#
# `uxr/baseline/` and `uxr/prototype/` ARE committed: they are the frozen
# derivations of the live app the refinement was argued over, and the record of
# what was decided is worth nothing without them. The renders are not — every
# round re-shoots every frame from the HTML in a couple of seconds.
uxr/renders/

# Nor are the before/after captures of the finished work: `UXR_OUT=before|after
# npm run uxr:capture` re-derives them from the running app, and what the
# walkthrough actually ships is the optimised JPEGs under `docs/uxr/`.
uxr/before/
uxr/after/

# `npm run typecheck` is `tsc -b --noEmit false`, so it writes a .js beside
# every .ts it checks. They are build output, not source — and there is no
# hand-written JavaScript under any of these trees, so the pattern is safe.
/src/**/*.js
/tests/**/*.js
/scripts/**/*.js
/firestore-tests/**/*.js
/e2e/**/*.js
/uxr/**/*.js
# `npm run typecheck` also emits beside the root-level configs it checks, and
# those are not covered by the per-directory patterns above.
/*.config.js
!eslint.config.js

# The assembled walkthrough page — a megabyte and a half of the same JPEGs
# inlined as base64. `docs/uxr/before` and `docs/uxr/after` ARE committed; this
# rebuilds from them with `npm run uxr:walkthrough`.
docs/uxr/walkthrough.html

# UXR renders — regenerable from the prototypes with `uxr/shoot.ts`, and a round
# is a few megabytes of PNG. The critiques themselves are the record and are
# tracked; the frames they were made from are not.
/uxr/rounds/**/*.png
/uxr/renders/
