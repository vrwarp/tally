node_modules/
dist/
dist-ssr/
*.local

# Local env — never commit real Firebase config or API keys.
.env
.env.*
!.env.example
!.env.emulated

# Planning Center credentials for the local functions emulator.
# `.env.demo-tally` is deliberately NOT ignored: it holds only simulator
# settings for the emulator-only `demo-` project namespace. The negation has to
# be spelled out — `.env.*` above matches at every level, so without this line
# the file was ignored despite this comment, and no clone or CI checkout has ever
# had it. The Functions emulator then stops to prompt for the params it declares,
# loads nothing, and every end-to-end sign-in fails on a 404 from
# `provisionAccess`.
!functions/.env.demo-tally
functions/.secret.local
functions/.env
functions/.env.local
functions/lib/

# Firebase
.firebase/
.emulator-data/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
*-debug.log

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Test output
coverage/

# Walkthrough build products.
#
# `docs/walkthrough/web/*.jpg` IS committed — it is what the Markdown shows and
# it is only ~700 kB. These two are not: the PNGs are 4 MB of archival
# originals, and the HTML page is another megabyte of the same images inlined as
# base64. Both regenerate with `npm run walkthrough`.
docs/walkthrough/shots/
docs/walkthrough/walkthrough.html
docs/walkthrough/parents/shots/
docs/walkthrough/parents/index.html

# The `.artifact.html` twin of a walkthrough page is the same frames again,
# rebuilt for publishing rather than for reading in the repository. Nothing
# links to one; both build alongside the page they twin.
docs/walkthrough/*.artifact.html
docs/walkthrough/*/*.artifact.html

# The theme walkthrough follows the same split, and its `web/*.png` are PNG
# rather than JPEG on purpose — a page arguing about which hue a gathering chose
# should not ship through a codec that stores colour at half resolution. See the
# header of `scripts/build-theme-walkthrough.ts` for the sizes that decided it.
docs/walkthrough/themes/shots/
docs/walkthrough/themes/themes.html

# Playwright output — regenerated by every run.
playwright-report/
test-results/
blob-report/
tsconfig.tsbuildinfo

# The kiosk benchmark's report. Deliberately not under test-results/, which
# Playwright empties at the start of every run — a measurement that the next
# `npm run e2e` deletes is a measurement nobody can compare against.
perf-results/

# UXR refinement working files — none of them are committed.
#
# The frozen scenes, the prototypes edited on top of them and the frames shot
# from those are all *working* files: they exist while a refinement is being
# argued and are re-derived from the running app on demand. They used to be
# committed on the reasoning that a critique is worth nothing without the frame
# it judged — true while a loop is running, and the reason the loop's own
# conclusions are now written down in prose instead. What survived those
# arguments is in `src/`; what it settled is in `docs/refinements.md`.
#
# Everything below regenerates: `npm run uxr:capture` for the walked-to scenes,
# `uxr:team` / `uxr:kiosk-setup` for the mounted ones, `uxr:shoot` for the PNGs.
uxr/baseline/
uxr/prototype*/
uxr/renders/
uxr/before/
uxr/after/
uxr/before-team/
uxr/after-team/
uxr/before-kiosk/
uxr/after-kiosk/
uxr/before-sync/

# Emitted JavaScript, kept ignored as a backstop.
#
# `npm run typecheck` used to be `tsc -b --noEmit false`, which wrote a .js
# beside every .ts it checked — several hundred of them, invisible because of
# exactly these patterns, and actively harmful: Vite resolves a sibling .js
# before the .tsx, so `npm test` ran yesterday's compiled output and reported
# it as passing. The script honours `noEmit` now and emits nothing.
#
# The patterns stay because a checkout that still has those files, or anyone
# running the old command from memory, should not see six hundred untracked
# files. There is no hand-written JavaScript under any of these trees, so
# ignoring the extension outright is safe.
/src/**/*.js
/tests/**/*.js
/scripts/**/*.js
/firestore-tests/**/*.js
/e2e/**/*.js
/uxr/**/*.js
# Same backstop for the root-level configs, which the per-directory patterns
# above do not cover.
/*.config.js
!eslint.config.js

# The assembled walkthrough page — a megabyte and a half of the same JPEGs
# inlined as base64. `docs/uxr/before` and `docs/uxr/after` ARE committed; this
# rebuilds from them with `npm run uxr:walkthrough`.
docs/uxr/walkthrough.html
docs/uxr/team-walkthrough.html
docs/uxr/kiosk-walkthrough.html

# Round working directories, for a refinement that is currently running.
# Converged campaigns are summarised in `docs/refinements.md` instead.
/uxr/rounds/

# One-off measuring scripts the critique agents write beside the prototypes to
# read a rendered frame's geometry. They are a step in an argument, not a tool —
# the numbers they produced are quoted in the round's critique, which is tracked.
/uxr/_*
/uxr/.measure-*

# The e2e log, when a run is driven by hand rather than by CI.
e2e-run.log

# Mutation testing
.stryker-tmp/
reports/mutation/
