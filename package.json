{
  "name": "tally",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Attendance tracking for a youth ministry (6th-12th grade).",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "tools/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-kiosk-budget.mjs",
    "preview": "vite preview",
    "deploy": "tsx scripts/deploy.ts",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tally \"vitest run --project rules --no-file-parallelism\"",
    "test:functions": "npm --prefix functions run test",
    "test:all": "npm run test && npm run test:functions && npm run test:rules",
    "functions:build": "npm --prefix functions run build",
    "functions:invokers": "tsx scripts/callable-invokers.ts",
    "prune:occurrences": "npm --prefix functions run build && node functions/lib/prune.js",
    "repair:chains": "npm --prefix functions run build && node functions/lib/repair.js",
    "functions:install": "npm --prefix functions install",
    "emulators": "firebase emulators:start --project demo-tally --export-on-exit=./.emulator-data",
    "emulators:resume": "firebase emulators:start --project demo-tally --import=./.emulator-data --export-on-exit=./.emulator-data",
    "seed": "tsx scripts/seed.ts",
    "verify:seed": "tsx scripts/verify-seed.ts",
    "dev:emulated": "npm run functions:build && concurrently -k -n emulators,vite -c magenta,cyan \"firebase emulators:start --project demo-tally\" \"vite --mode emulated\"",
    "pco-sim": "tsx tools/pco-simulator/src/server.ts",
    "a32-sim": "tsx tools/a32-simulator/src/server.ts",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "e2e:report": "playwright show-report",
    "perf:kiosk": "KIOSK_PERF=1 playwright test --project=chromium-desktop e2e/kiosk-perf.spec.ts",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "walkthrough:capture": "WALKTHROUGH=1 playwright test --project=chromium-desktop e2e/walkthrough.spec.ts && WALKTHROUGH=1 playwright test --project=chromium-mobile e2e/walkthrough.spec.ts",
    "walkthrough:build": "tsx scripts/build-walkthrough.ts",
    "walkthrough": "npm run walkthrough:capture && npm run walkthrough:optimize && npm run walkthrough:build",
    "walkthrough:optimize": "tsx scripts/optimize-screenshots.ts",
    "tour:capture": "WALKTHROUGH=1 playwright test --project=chromium-desktop e2e/tour.spec.ts",
    "tour:build": "tsx scripts/build-tour.ts",
    "tour": "npm run tour:capture && npm run tour:build",
    "walkthrough:themes:capture": "WALKTHROUGH=1 playwright test --project=chromium-desktop e2e/theme-walkthrough.spec.ts",
    "walkthrough:themes:build": "tsx scripts/build-theme-walkthrough.ts",
    "walkthrough:themes": "npm run walkthrough:themes:capture && npm run walkthrough:themes:build",
    "walkthrough:registration:capture": "WALKTHROUGH=1 playwright test --project=chromium-desktop e2e/registration-walkthrough.spec.ts",
    "walkthrough:registration:build": "tsx scripts/build-registration-walkthrough.ts",
    "walkthrough:registration": "npm run walkthrough:registration:capture && npm run walkthrough:registration:build",
    "walkthrough:edit-queue:capture": "node scripts/capture-edit-queue-walkthrough.mjs",
    "walkthrough:edit-queue:build": "tsx scripts/build-edit-queue-walkthrough.ts",
    "walkthrough:edit-queue": "npm run walkthrough:edit-queue:capture",
    "walkthrough:corrections:capture": "tsx uxr/review-live/shoot.ts",
    "walkthrough:corrections:build": "tsx scripts/build-corrections-walkthrough.ts",
    "walkthrough:corrections": "npm run walkthrough:corrections:capture && npm run walkthrough:corrections:build",
    "walkthrough:identity": "tsx uxr/identity-live/build.ts && tsx uxr/identity-live/verify.mts",
    "uxr:capture": "playwright test -c uxr/playwright.config.ts",
    "uxr:shoot": "tsx uxr/shoot.ts",
    "uxr:kiosk": "tsx uxr/kiosk-live/shoot.ts",
    "uxr:team": "tsx uxr/team-live/freeze.ts",
    "uxr:measure": "tsx uxr/measure.ts uxr/before uxr/after",
    "uxr:shots": "tsx scripts/optimize-uxr-shots.ts",
    "uxr:walkthrough": "tsx scripts/build-uxr-walkthrough.ts && tsx scripts/check-uxr-walkthrough.ts",
    "uxr:team-walkthrough": "tsx scripts/build-uxr-walkthrough.ts team-changes.json team-walkthrough.html && tsx scripts/check-uxr-walkthrough.ts docs/uxr/team-walkthrough.html",
    "uxr:kiosk-setup": "tsx uxr/kiosk-setup-live/freeze.ts",
    "uxr:kiosk-walkthrough": "tsx scripts/build-uxr-walkthrough.ts kiosk-changes.json kiosk-walkthrough.html && tsx scripts/check-uxr-walkthrough.ts docs/uxr/kiosk-walkthrough.html"
  },
  "dependencies": {
    "@vrwarp/brother-ql-webusb": "^0.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-tools": "^15.25.1",
    "globals": "^17.10.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.10"
  }
}
