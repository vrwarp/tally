{
  "name": "tally",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Attendance tracking for a youth ministry (6th-12th grade).",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "tools/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-kiosk-budget.mjs",
    "preview": "vite preview",
    "deploy": "tsx scripts/deploy.ts",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tally \"vitest run --project rules --no-file-parallelism\"",
    "test:functions": "npm --prefix functions run test",
    "test:all": "npm run test && npm run test:functions && npm run test:rules",
    "functions:build": "npm --prefix functions run build",
    "functions:invokers": "tsx scripts/callable-invokers.ts",
    "prune:occurrences": "npm --prefix functions run build && node functions/lib/prune.js",
    "functions:install": "npm --prefix functions install",
    "emulators": "firebase emulators:start --project demo-tally --export-on-exit=./.emulator-data",
    "emulators:resume": "firebase emulators:start --project demo-tally --import=./.emulator-data --export-on-exit=./.emulator-data",
    "seed": "tsx scripts/seed.ts",
    "verify:seed": "tsx scripts/verify-seed.ts",
    "dev:emulated": "npm run functions:build && concurrently -k -n emulators,vite -c magenta,cyan \"firebase emulators:start --project demo-tally\" \"vite --mode emulated\"",
    "pco-sim": "tsx tools/pco-simulator/src/server.ts",
    "a32-sim": "tsx tools/a32-simulator/src/server.ts",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "e2e:report": "playwright show-report",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "walkthrough:capture": "WALKTHROUGH=1 playwright test --project=chromium-desktop e2e/walkthrough.spec.ts && WALKTHROUGH=1 playwright test --project=chromium-mobile e2e/walkthrough.spec.ts",
    "walkthrough:build": "tsx scripts/build-walkthrough.ts",
    "walkthrough": "npm run walkthrough:capture && npm run walkthrough:optimize && npm run walkthrough:build",
    "walkthrough:optimize": "tsx scripts/optimize-screenshots.ts",
    "uxr:capture": "playwright test -c uxr/playwright.config.ts",
    "uxr:shoot": "tsx uxr/shoot.ts",
    "uxr:measure": "tsx uxr/measure.ts uxr/before uxr/after",
    "uxr:shots": "tsx scripts/optimize-uxr-shots.ts",
    "uxr:walkthrough": "tsx scripts/build-uxr-walkthrough.ts && tsx scripts/check-uxr-walkthrough.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "^14.6.0",
    "globals": "^17.8.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.34.1",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.10"
  }
}
