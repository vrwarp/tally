    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
