rules_version = '2';

/**
 * Tally security rules (PRD 4.5).
 *
 * Authentication by itself grants nothing. Authorisation is the `users/{uid}`
 * document: it must exist and carry `active: true`. Roles rank
 * counselor < core < admin, and every collection below is expressed as
 * "read by anyone authorised, write by role X, plus these shape constraints".
 *
 * Cloud Functions run on the Admin SDK and bypass rules entirely, so anything
 * only a function may do — writing the Planning Center linkage, the sync
 * cursor, the access allowlist — is flatly denied to clients here rather than
 * being guarded by a condition a client could talk its way past.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------- */
    /* Identity                                                          */
    /* ---------------------------------------------------------------- */

    function isSignedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    /**
     * The caller's authorisation document.
     *
     * Every helper funnels through this single path so the rules engine's
     * per-request lookup cache collapses an entire evaluation — isActive,
     * hasRole, isCore — into one billed read against the 10-lookup budget.
     */
    function profile() {
      return get(profilePath()).data;
    }

    function isActive() {
      return isSignedIn() && exists(profilePath()) && profile().get('active', false) == true;
    }

    function rank(role) {
      return {'counselor': 1, 'core': 2, 'admin': 3}.get(role, 0);
    }

    function hasRole(required) {
      return isActive() && rank(profile().get('role', '')) >= rank(required);
    }

    function isCounselor() { return hasRole('counselor'); }
    function isCore() { return hasRole('core'); }
    function isAdmin() { return hasRole('admin'); }

    /*
     * Field-level diffing. Firestore evaluates both the create and the update
     * rule for a `set()` and picks the one matching the document's actual
     * existence, so these must stay defined when `resource` is null: a create
     * counts as touching everything and as touching nothing exclusively.
     */

    function touches(keys) {
      return resource == null
        || request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function touchesOnly(keys) {
      return resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    /* ---------------------------------------------------------------- */
    /* users — the authorisation table itself                            */
    /* ---------------------------------------------------------------- */

    match /users/{uid} {
      function validUser() {
        let d = request.resource.data;
        return d.email is string
          && d.email.size() > 0
          && d.role in ['counselor', 'core', 'admin']
          && d.active is bool;
      }

      /**
       * A user may always read their own document, even unauthorised:
       * AuthProvider subscribes to it before it knows whether the person is a
       * member, and treats a denial as "pending". Denying the read would make
       * a legitimate pending user indistinguishable from an error.
       */
      allow get: if isSignedIn() && (request.auth.uid == uid || isActive());
      allow list: if isActive();

      /**
       * Role and `active` are the only things standing between a signed-in
       * stranger and the whole ministry's data, so no one may write those two
       * fields on their own document — not even an admin. Granting a role is
       * always an act performed *on someone else*.
       */
      allow create: if isAdmin() && request.auth.uid != uid && validUser();
      /**
       * The one field a person maintains on themselves: the sign-in heartbeat.
       * Everything else on a profile is an authorisation decision, and those
       * are made on someone else.
       */
      allow update: if (isAdmin() && validUser() && !(request.auth.uid == uid && touches(['role', 'active'])))
                    || (isSignedIn() && request.auth.uid == uid
                        && touchesOnly(['lastSeenAt']));
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    /* ---------------------------------------------------------------- */
    /* invitations — who may sign in at all                              */
    /* ---------------------------------------------------------------- */

    /*
     * Keyed by address, because it is written before the person has ever
     * signed in and a uid does not exist until they do.
     *
     * This is the allowlist that used to be a Planning Center List. A List is
     * generated from filter rules, so "these particular twelve adults may see a
     * roster of minors" was only expressible by inventing a custom field on
     * every person in the church — an access decision stored in a system whose
     * editors are a different set of people from the ones who should be making
     * it. It belongs here, where an admin makes it deliberately.
     *
     * Admin-only in both directions. The read matters as much as the write:
     * this is a list of church staff email addresses, and a counselor's phone
     * has no reason to hold one.
     */
    match /invitations/{emailKey} {
      function validInvitation() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'role', 'active', 'invitedAt', 'invitedBy', 'note'])
          && d.email is string
          && d.email.size() > 0
          && d.role in ['counselor', 'core', 'admin']
          && d.active is bool
          && (!('note' in d.keys()) || d.note is string);
      }

      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && validInvitation();
      allow delete: if isAdmin();
    }

    /* ---------------------------------------------------------------- */
    /* students                                                          */
    /* ---------------------------------------------------------------- */

    /*
     * This collection *is* the roster — the membership, not the people.
     *
     * A document here says somebody put this student on Tally's roster. What it
     * does not say is who they are: for a student linked to Planning Center the
     * name, grade and everything else are read live through a callable and
     * stored nowhere. What lives here is the membership itself plus what
     * Planning Center has no opinion about — a note, when somebody first
     * turned up — plus the whole record for a quick-added visitor until the
     * push lands.
     *
     * Three consequences for these rules. A document is sparse, so field
     * validation only applies to fields that are present. Parent contact and
     * allergies are not writable at all: Tally does not hold them, and a client
     * that could write them here would be recreating the mirror one document at
     * a time. And the Planning Center linkage is still not a client's to
     * assert — putting a person on the roster goes through a callable that
     * checks the id upstream first, because `students/pco_123` is a claim about
     * a real child, not a preference.
     */
    match /students/{studentId} {
      function validStudent() {
        let d = request.resource.data;
        return (!('firstName' in d.keys()) || (d.firstName is string && d.firstName.size() > 0))
          && (!('lastName' in d.keys()) || (d.lastName is string && d.lastName.size() > 0))
          && (!('grade' in d.keys()) || (d.grade is int && d.grade >= 6 && d.grade <= 12))
          && (!('status' in d.keys()) || d.status in ['active', 'inactive']);
      }

      /**
       * Fields Tally must never store, whatever a client sends.
       *
       * This is the mirror-removal made enforceable rather than merely
       * intended: a future screen that "just" saves a phone number here would
       * be rejected by the database, not caught in review.
       */
      function noMirroredPersonalData() {
        let keys = request.resource.data.keys();
        return !('parentName' in keys)
          && !('parentPhone' in keys)
          && !('parentEmail' in keys)
          && !('allergies' in keys);
      }

      /**
       * Planning Center owns the linkage. A client may declare a student as
       * "mine, not yet pushed" (`pcoPersonId: null`, `pcoPushPending: true`)
       * but may never assert an id — forging one would let a browser rebind a
       * Tally student onto an arbitrary Planning Center person.
       */
      function pcoLinkageUnclaimed() {
        return request.resource.data.get('pcoPersonId', null) == null;
      }

      function pcoLinkageUnchanged() {
        let after = request.resource.data;
        let before = resource == null ? {} : resource.data;
        return after.get('pcoPersonId', null) == before.get('pcoPersonId', null);
      }

      /**
       * `pcoRecordMissing` is what freezes a student's check-ins when their
       * Planning Center record dies, and it is set and cleared server-side
       * from what Planning Center actually answers. A client that could flip
       * it would be a client that can thaw a frozen student by asserting the
       * record came back — so, like the linkage it rides on, it is not a
       * client's to write.
       */
      function pcoRecordFlagUnchanged() {
        let after = request.resource.data;
        let before = resource == null ? {} : resource.data;
        return after.get('pcoRecordMissing', false) == before.get('pcoRecordMissing', false);
      }

      allow get, list: if isActive();

      // Quick-add happens at the door, and check-in itself writes
      // firstAttendedAt/lastAttendedAt, so counselors need create and update.
      allow create: if isCounselor()
                    && validStudent()
                    && noMirroredPersonalData()
                    && pcoLinkageUnclaimed()
                    && request.resource.data.get('pcoRecordMissing', false) == false;
      allow update: if isCounselor()
                    && validStudent()
                    && noMirroredPersonalData()
                    && pcoLinkageUnchanged()
                    && pcoRecordFlagUnchanged();

      // Never. Attendance documents reference students by id; deleting one
      // would silently orphan history. Set `status: 'inactive'` instead.
      allow delete: if false;
    }

    /* ---------------------------------------------------------------- */
    /* events (+ attendance and RSVP subcollections)                     */
    /* ---------------------------------------------------------------- */

    match /events/{eventId} {
      /**
       * A recurrence rule is a small closed vocabulary, and the client expands
       * it into dates without re-checking. An unknown `frequency` or a
       * negative `interval` written straight to the collection would have the
       * event page describing a schedule nobody can read, so the shape is
       * pinned here as well as in the converter.
       *
       * The anchor-derived parts (day of month, weekday position, month of a
       * yearly rule) are deliberately absent — they come from `startAt`, so
       * there is nothing here that can contradict the event's own date.
       */
      function validRecurrence(r) {
        return r is map
          // `daily` is no longer written — it is every weekday of a weekly
          // rule — but it stays accepted so a stale cached bundle's write is
          // not rejected outright. The converter folds it on read.
          && r.frequency in ['daily', 'weekly', 'monthly', 'yearly']
          && r.interval is int && r.interval >= 1 && r.interval <= 99
          && r.weekdays is list && r.weekdays.size() <= 7
          && r.monthlyMode in ['dayOfMonth', 'dayOfWeek']
          && (r.until == null || r.until is string)
          // RFC 5545: an end date and an occurrence tally must not both apply.
          && (r.count == null || (r.count is int && r.count >= 1 && r.until == null));
      }

      function validEvent() {
        let d = request.resource.data;
        let recurrence = d.get('recurrence', null);
        return d.startAt is timestamp
          && d.endAt is timestamp
          && d.checkInOpensAt is timestamp
          && d.checkInClosesAt is timestamp
          && d.mode in ['recurring', 'oneoff']
          && (recurrence == null || validRecurrence(recurrence));
      }

      allow get, list: if isActive();

      // Core and up only: moving an event's date mid-check-in would swap the
      // active event out from under every counselor's phone at once.
      allow create, update: if isCore() && validEvent();

      /**
       * Never from a client, even for the core team who may do everything else
       * here.
       *
       * Not because deleting a gathering is forbidden — the event page offers
       * it, and offers ending a whole repeat — but because deleting *this
       * document* is only half of it. The attendance and RSVPs underneath are a
       * subcollection, and a subcollection does not go with its parent: what
       * would be left is history no screen can reach and every collection-group
       * query still counts. Rules cannot enumerate a subcollection, so they
       * cannot make a client do the other half; what they can do is make sure
       * the request goes to the one place that does. See
       * `functions/src/eventDeletion.ts`.
       */
      allow delete: if false;

      match /attendance/{studentId} {
        /**
         * The doc id *is* the student id — that is what makes two counselors
         * tapping the same student converge on one record. Enforced here rather
         * than trusted to the client, because idempotency that depends on
         * well-behaved callers is not idempotency.
         */
        function validAttendance() {
          let d = request.resource.data;
          return d.studentId == studentId
            && d.eventId == eventId
            && d.checkedInBy == request.auth.uid;
        }

        /**
         * A student whose Planning Center record died is frozen: no check-in,
         * no un-check-in, past events included, until somebody removes them
         * from the roster or re-creates the record. The flag lives on the
         * membership document and only the server writes it, so this is not a
         * client honour system — a stale tab back-filling a deleted student
         * into last month's gathering is refused by the database. The
         * `exists()` guard keeps the historical behaviour for a student with
         * no document yet: check-in is frequently what creates it.
         */
        function checkInFrozen() {
          return exists(/databases/$(database)/documents/students/$(studentId))
            && get(/databases/$(database)/documents/students/$(studentId))
                 .data.get('pcoRecordMissing', false) == true;
        }

        allow get, list: if isActive();
        allow create, update: if isCounselor() && validAttendance() && !checkInFrozen();
        allow delete: if isCounselor() && !checkInFrozen();
      }

      /**
       * Who is expected on a one-off event.
       *
       * Core-only for every write. A counselor reads the list — with
       * `requiresRsvp` it is their roster — but who is on the trip is a decision
       * made before the door, not at it.
       */
      match /rsvps/{studentId} {
        function validRsvp() {
          let d = request.resource.data;
          return d.studentId == studentId && d.eventId == eventId;
        }

        allow get, list: if isActive();
        allow create, update: if isCore() && validRsvp();
        allow delete: if isCore();
      }
    }

    /* ---------------------------------------------------------------- */
    /* Reference data                                                    */
    /* ---------------------------------------------------------------- */

    match /eventSeries/{seriesId} {
      allow get, list: if isActive();
      allow write: if isCore();
    }

    /* ---------------------------------------------------------------- */
    /* config                                                            */
    /* ---------------------------------------------------------------- */

    match /config/settings {
      // The predictive window has to contain the threshold, or the roster's
      // "Recent" block can never be satisfied and silently renders empty.
      function validSettings() {
        let d = request.resource.data;
        return d.predictiveMinAttended is int
          && d.predictiveMinAttended >= 1
          && d.predictiveOfLastN is int
          && d.predictiveOfLastN >= d.predictiveMinAttended
          && d.miaConsecutiveMisses is int
          && d.miaConsecutiveMisses >= 1
          && d.newVisitorWindowDays is int
          && d.newVisitorWindowDays >= 1;
      }

      allow get: if isActive();
      allow write: if isCore() && validSettings();
    }

    /*
     * The non-secret half of the Planning Center configuration.
     *
     * This document is why a church can move its roster onto a different
     * Planning Center list without a deploy. The Personal Access Token is
     * deliberately not here and never will be: credentials live in Secret
     * Manager, where a browser cannot reach them even with an admin signed in.
     *
     * Read is core-only. Nothing on a counselor's screen depends on it — the
     * server resolves the configuration itself before answering any callable —
     * so there is no reason for a door volunteer's device to hold the shape of
     * the church's Planning Center account.
     */
    match /config/planningCenter {
      function validPcoConfig() {
        let d = request.resource.data;
        /*
         * A closed shape, unlike every other document in this file.
         *
         * The reason is specific: the one thing that must never appear here is
         * a Personal Access Token. Listing what is allowed — rather than
         * validating what is recognised and ignoring the rest — is what makes
         * "somebody stashed credentials in the config document" a write the
         * database refuses rather than a habit nobody notices.
         */
        return d.keys().hasOnly([
              'rosterSource', 'studentListId', 'counselorListId',
              'minGrade', 'maxGrade', 'writeBack',
              'cacheTtlSeconds', 'baseUrl', 'updatedAt', 'updatedBy',
            ])
          && (!('rosterSource' in d.keys()) || d.rosterSource in ['list', 'grade'])
          && (!('studentListId' in d.keys()) || d.studentListId is string)
          && (!('counselorListId' in d.keys()) || d.counselorListId is string)
          && (!('writeBack' in d.keys()) || d.writeBack in ['off', 'create', 'full'])
          && (!('minGrade' in d.keys()) || (d.minGrade is int && d.minGrade >= 6 && d.minGrade <= 12))
          && (!('maxGrade' in d.keys()) || (d.maxGrade is int && d.maxGrade >= 6 && d.maxGrade <= 12))
          && (!('minGrade' in d.keys()) || !('maxGrade' in d.keys()) || d.maxGrade >= d.minGrade)
          && (!('cacheTtlSeconds' in d.keys())
              || (d.cacheTtlSeconds is int && d.cacheTtlSeconds >= 0 && d.cacheTtlSeconds <= 300))
          && (!('baseUrl' in d.keys())
              || (d.baseUrl is string
                  && (d.baseUrl == '' || d.baseUrl.matches('https?://.*'))));
      }

      /**
       * The API root is the one field here that is not merely a preference.
       *
       * Every Planning Center request carries the church's Personal Access
       * Token, so whoever sets this address chooses where those credentials get
       * sent. That is an admin decision, not a core-team one — and the server
       * shows a standing "not the real Planning Center" warning whenever it is
       * set, so it cannot be changed quietly either.
       */
      function baseUrlUnchanged() {
        return resource == null
          ? request.resource.data.get('baseUrl', '') == ''
          : request.resource.data.get('baseUrl', '') == resource.data.get('baseUrl', '');
      }

      allow get: if isCore();
      allow write: if isCore() && validPcoConfig() && (isAdmin() || baseUrlUnchanged());
    }

    /*
     * `config/pcoSync` and `accessRoster` used to be matched here.
     *
     * Both are gone. `pcoSync` tracked a scheduled sweep that no longer exists;
     * `accessRoster` was a mirrored allowlist that `provisionAccess` now asks
     * Planning Center for directly, at the moment somebody signs in. Neither is
     * written any more, and the default-deny below covers anything that tries.
     */

    /* ---------------------------------------------------------------- */
    /* Default deny                                                      */
    /* ---------------------------------------------------------------- */

    // Firestore already denies unmatched paths; this is here so that a future
    // collection added without a rule fails loudly in review rather than
    // quietly inheriting nothing.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
