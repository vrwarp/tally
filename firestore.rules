rules_version = '2';

/**
 * Tally security rules (PRD 4.5).
 *
 * Authentication by itself grants nothing. Authorisation is the `users/{uid}`
 * document: it must exist and carry `active: true`. Roles rank
 * counselor < core < admin, and every collection below is expressed as
 * "read by anyone authorised, write by role X, plus these shape constraints".
 *
 * Cloud Functions run on the Admin SDK and bypass rules entirely, so anything
 * only a function may do — writing the Planning Center linkage, the sync
 * cursor, the access allowlist — is flatly denied to clients here rather than
 * being guarded by a condition a client could talk its way past.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------- */
    /* Identity                                                          */
    /* ---------------------------------------------------------------- */

    function isSignedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    /**
     * The caller's authorisation document.
     *
     * Every helper funnels through this single path so the rules engine's
     * per-request lookup cache collapses an entire evaluation — isActive,
     * hasRole, isCore — into one billed read against the 10-lookup budget.
     */
    function profile() {
      return get(profilePath()).data;
    }

    function isActive() {
      return isSignedIn() && exists(profilePath()) && profile().get('active', false) == true;
    }

    function rank(role) {
      return {'counselor': 1, 'core': 2, 'admin': 3}.get(role, 0);
    }

    function hasRole(required) {
      return isActive() && rank(profile().get('role', '')) >= rank(required);
    }

    function isCounselor() { return hasRole('counselor'); }
    function isCore() { return hasRole('core'); }
    function isAdmin() { return hasRole('admin'); }

    /* ---------------------------------------------------------------- */
    /* Per-gathering access                                              */
    /* ---------------------------------------------------------------- */

    /**
     * Whether the caller may *work* one gathering.
     *
     * See `match /eventAccess/{chainKey}` below for what that means and why it
     * is keyed on the chain. This is the restatement of `canWorkChain` in
     * `src/lib/eventAccess.ts` — rules cannot import, so there are two copies,
     * and these are the ones an attacker cannot skip.
     *
     * **`exists()` before `get()`, and the `||` carries the lookup.** A `get()`
     * at a path with no document raises rather than returning null, and a
     * raised lookup denies — so the natural `a == null || …` form would have
     * denied every gathering nobody had restricted, which is all of them on the
     * day this deploys. `firestore-tests/getSemantics.test.ts` is that fact,
     * pinned.
     *
     * Repeating the lookup rather than binding it to a `let` is deliberate:
     * `let` would evaluate it before the `exists()` guard could stop it. Rules
     * cache accesses by path within a request, so the repetition costs nothing
     * a `let` would have saved.
     */
    function accessPath(key) {
      return /databases/$(database)/documents/eventAccess/$(key);
    }

    function onChain(key) {
      return isAdmin()
        || !exists(accessPath(key))
        || get(accessPath(key)).data.get('restricted', false) != true
        || request.auth.uid in get(accessPath(key)).data.get('members', []);
    }

    /** `chainKey()` from `src/lib/materialize.ts`, over a document's data. */
    function chainOfData(d, id) {
      return d.get('seriesId', null) != null
        ? d.seriesId
        : (d.get('recurrenceRootId', null) != null ? d.recurrenceRootId : id);
    }

    /**
     * Which gathering an event belongs to.
     *
     * The fallback when the parent event has no document is its own id, which
     * is what `chainKey()` would say for a one-off — and it is also a gap worth
     * naming rather than hiding. A projected occurrence of a restricted chain
     * has no document until `materializeOccurrence` writes one, and its derived
     * id (`{chain}-{date}`) has no `eventAccess` document of its own, so an
     * attendance write aimed at that path before materialisation is not caught
     * here. What catches it is the callable: `materializeOccurrence` is gated on
     * the chain, so the occurrence never becomes real for somebody outside it,
     * and `getKioskEvents` refuses to bind a kiosk to a gathering its approver
     * cannot work. Rules cannot parse the chain back out of the derived id —
     * chain keys may themselves contain the separator — so this is the seam.
     */
    function eventChain(eventId) {
      let p = /databases/$(database)/documents/events/$(eventId);
      return exists(p) ? chainOfData(get(p).data, eventId) : eventId;
    }

    /**
     * A session minted by the kiosk pairing flow: a real staff member's uid,
     * carrying a `kiosk: true` custom claim.
     *
     * The kiosk stands in a lobby and is operated by the public, so its
     * session is the approver's *narrowed*: it may add an attendance record
     * and write the date patch a check-in makes, and nothing else — no
     * undo, no edits, no reading other people's profiles. Everything a kiosk
     * screen shows beyond that comes through callables, which gate
     * themselves.
     */
    function isKioskSession() {
      return isSignedIn() && request.auth.token.get('kiosk', false) == true;
    }

    /*
     * Field-level diffing. Firestore evaluates both the create and the update
     * rule for a `set()` and picks the one matching the document's actual
     * existence, so these must stay defined when `resource` is null: a create
     * counts as touching everything and as touching nothing exclusively.
     */

    function touches(keys) {
      return resource == null
        || request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function touchesOnly(keys) {
      return resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    /* ---------------------------------------------------------------- */
    /* users — the authorisation table itself                            */
    /* ---------------------------------------------------------------- */

    match /users/{uid} {
      function validUser() {
        let d = request.resource.data;
        return d.email is string
          && d.email.size() > 0
          && d.role in ['counselor', 'core', 'admin']
          && d.active is bool;
      }

      /**
       * A user may always read their own document, even unauthorised:
       * AuthProvider subscribes to it before it knows whether the person is a
       * member, and treats a denial as "pending". Denying the read would make
       * a legitimate pending user indistinguishable from an error.
       */
      // A kiosk session is refused even its own profile: nothing a lobby
      // screen renders needs one, and the deny costs it nothing.
      allow get: if isSignedIn() && !isKioskSession() && (request.auth.uid == uid || isActive());
      allow list: if isActive() && !isKioskSession();

      /**
       * Role and `active` are the only things standing between a signed-in
       * stranger and the whole ministry's data, so no one may write those two
       * fields on their own document — not even an admin. Granting a role is
       * always an act performed *on someone else*.
       */
      allow create: if isAdmin() && request.auth.uid != uid && validUser();
      /**
       * The one field a person maintains on themselves: the sign-in heartbeat.
       * Everything else on a profile is an authorisation decision, and those
       * are made on someone else.
       */
      allow update: if (isAdmin() && validUser() && !(request.auth.uid == uid && touches(['role', 'active'])))
                    || (isSignedIn() && request.auth.uid == uid
                        && touchesOnly(['lastSeenAt']));
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    /* ---------------------------------------------------------------- */
    /* invitations — who may sign in at all                              */
    /* ---------------------------------------------------------------- */

    /*
     * Keyed by address, because it is written before the person has ever
     * signed in and a uid does not exist until they do.
     *
     * This is the allowlist that used to be a Planning Center List. A List is
     * generated from filter rules, so "these particular twelve adults may see a
     * roster of minors" was only expressible by inventing a custom field on
     * every person in the church — an access decision stored in a system whose
     * editors are a different set of people from the ones who should be making
     * it. It belongs here, where an admin makes it deliberately.
     *
     * Admin-only in both directions. The read matters as much as the write:
     * this is a list of church staff email addresses, and a counselor's phone
     * has no reason to hold one.
     */
    match /invitations/{emailKey} {
      function validInvitation() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'role', 'active', 'invitedAt', 'invitedBy', 'note'])
          && d.email is string
          && d.email.size() > 0
          && d.role in ['counselor', 'core', 'admin']
          && d.active is bool
          && (!('note' in d.keys()) || d.note is string);
      }

      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && validInvitation();
      allow delete: if isAdmin();
    }

    /* ---------------------------------------------------------------- */
    /* students                                                          */
    /* ---------------------------------------------------------------- */

    /*
     * This collection *is* the roster — the membership, not the people.
     *
     * A document here says somebody put this student on Tally's roster. What it
     * does not say is who they are: for a student linked to Planning Center the
     * name, grade and everything else are read live through a callable and
     * stored nowhere. What lives here is the membership itself plus what
     * Planning Center has no opinion about — a note, when somebody first
     * turned up — plus the whole record for a quick-added visitor until the
     * push lands.
     *
     * Three consequences for these rules. A document is sparse, so field
     * validation only applies to fields that are present. Parent contact and
     * allergies are not writable at all: Tally does not hold them, and a client
     * that could write them here would be recreating the mirror one document at
     * a time. And the Planning Center linkage is still not a client's to
     * assert — putting a person on the roster goes through a callable that
     * checks the id upstream first, because `students/pco_123` is a claim about
     * a real child, not a preference.
     */
    match /students/{studentId} {
      function validStudent() {
        let d = request.resource.data;
        return (!('firstName' in d.keys()) || (d.firstName is string && d.firstName.size() > 0))
          && (!('lastName' in d.keys()) || (d.lastName is string && d.lastName.size() > 0))
          // 0 is kindergarten. Absent is a real state — somebody too young to
          // have a grade, or an adult on a hand-picked roster.
          && (!('grade' in d.keys()) || (d.grade is int && d.grade >= 0 && d.grade <= 12))
          && (!('status' in d.keys()) || d.status in ['active', 'inactive']);
      }

      /**
       * Fields Tally must never store, whatever a client sends.
       *
       * This is the mirror-removal made enforceable rather than merely
       * intended: a future screen that "just" saves a phone number here would
       * be rejected by the database, not caught in review.
       */
      function noMirroredPersonalData() {
        let keys = request.resource.data.keys();
        return !('parentName' in keys)
          && !('parentPhone' in keys)
          && !('parentEmail' in keys)
          && !('allergies' in keys);
      }

      /**
       * The backend owns the linkage. A client may declare a student as
       * "mine, not yet pushed" (`pcoPersonId: null`, `upstreamPushPending: true`)
       * but may never assert an id — forging one would let a browser rebind a
       * Tally student onto an arbitrary person in the church's database.
       *
       * Two shapes of the same claim, both server-written only: `pcoPersonId`
       * is the legacy Planning Center field and keeps meaning exactly that,
       * while `upstreamBackend`/`upstreamPersonId` are the pair every backend
       * writes — Planning Center writes both, so documents from before the
       * pair existed need no migration.
       */
      function pcoLinkageUnclaimed() {
        return request.resource.data.get('pcoPersonId', null) == null;
      }

      function pcoLinkageUnchanged() {
        let after = request.resource.data;
        let before = resource == null ? {} : resource.data;
        return after.get('pcoPersonId', null) == before.get('pcoPersonId', null);
      }

      function upstreamLinkageUnclaimed() {
        return request.resource.data.get('upstreamBackend', null) == null
          && request.resource.data.get('upstreamPersonId', null) == null;
      }

      function upstreamLinkageUnchanged() {
        let after = request.resource.data;
        let before = resource == null ? {} : resource.data;
        return after.get('upstreamBackend', null) == before.get('upstreamBackend', null)
          && after.get('upstreamPersonId', null) == before.get('upstreamPersonId', null);
      }

      /**
       * `upstreamRecordMissing` is what freezes a student's attendance when
       * their backend record dies — whichever backend holds them — and it is
       * set and cleared server-side from what the backend actually answers. A
       * client that could flip it would be a client that can thaw a frozen
       * student by asserting the record came back — so, like the linkage it
       * rides on, it is not a client's to write.
       */
      function recordMissingUnchanged() {
        let after = request.resource.data;
        let before = resource == null ? {} : resource.data;
        return after.get('upstreamRecordMissing', false) == before.get('upstreamRecordMissing', false);
      }

      /**
       * `pendingReview` holds a self-registered family out of the church's
       * people database until somebody has looked at them — see
       * functions/src/backends/pendingReview.ts. It is the *only* thing gating
       * the push, so a client that could clear it would be a client with a
       * direct, unreviewed line into Planning Center; a client that could set
       * it could quietly freeze a student a leader added by hand.
       *
       * Neither direction, then. It is written by `registerFamily` and cleared
       * by `approveRegistration`, both server-side, and this rule says so to
       * the database rather than to a reviewer.
       */
      function reviewHoldUnchanged() {
        let after = request.resource.data;
        let before = resource == null ? {} : resource.data;
        return after.get('pendingReview', false) == before.get('pendingReview', false);
      }

      /**
       * The only student write a kiosk makes is the date patch riding on a
       * check-in — see `studentDatePatch` in src/services/attendancePayloads.ts.
       * Pinning the key set here means a compromised kiosk session cannot
       * touch `notes`, `status`, or anything else a full counselor session
       * may: the create case covers the patch creating the document, the
       * update case covers it merging onto one.
       */
      function kioskDatePatchKeys() {
        return ['firstName', 'lastName', 'grade', 'searchName',
                'firstAttendedAt', 'lastAttendedAt', 'updatedAt', 'updatedBy'];
      }

      function kioskWriteAllowed() {
        return !isKioskSession()
          || (resource == null && request.resource.data.keys().hasOnly(kioskDatePatchKeys()))
          || touchesOnly(kioskDatePatchKeys());
      }

      allow get, list: if isActive();

      // Quick-add happens at the door, and check-in itself writes
      // firstAttendedAt/lastAttendedAt, so counselors need create and update.
      allow create: if isCounselor()
                    && validStudent()
                    && noMirroredPersonalData()
                    && pcoLinkageUnclaimed()
                    && upstreamLinkageUnclaimed()
                    && kioskWriteAllowed()
                    && reviewHoldUnchanged()
                    && request.resource.data.get('upstreamRecordMissing', false) == false;
      allow update: if isCounselor()
                    && validStudent()
                    && noMirroredPersonalData()
                    && pcoLinkageUnchanged()
                    && upstreamLinkageUnchanged()
                    && kioskWriteAllowed()
                    && recordMissingUnchanged()
                    && reviewHoldUnchanged();

      // Never. Attendance documents reference students by id; deleting one
      // would silently orphan history. Set `status: 'inactive'` instead.
      allow delete: if false;
    }

    /* ---------------------------------------------------------------- */
    /* events (+ attendance and RSVP subcollections)                     */
    /* ---------------------------------------------------------------- */

    match /events/{eventId} {
      /**
       * A recurrence rule is a small closed vocabulary, and the client expands
       * it into dates without re-checking. An unknown `frequency` or a
       * negative `interval` written straight to the collection would have the
       * event page describing a schedule nobody can read, so the shape is
       * pinned here as well as in the converter.
       *
       * The anchor-derived parts (day of month, weekday position, month of a
       * yearly rule) are deliberately absent — they come from `startAt`, so
       * there is nothing here that can contradict the event's own date.
       */
      function validRecurrence(r) {
        return r is map
          // `daily` is no longer written — it is every weekday of a weekly
          // rule — but it stays accepted so a stale cached bundle's write is
          // not rejected outright. The converter folds it on read.
          && r.frequency in ['daily', 'weekly', 'monthly', 'yearly']
          && r.interval is int && r.interval >= 1 && r.interval <= 99
          && r.weekdays is list && r.weekdays.size() <= 7
          && r.monthlyMode in ['dayOfMonth', 'dayOfWeek']
          && (r.until == null || r.until is string)
          // RFC 5545: an end date and an occurrence tally must not both apply.
          && (r.count == null || (r.count is int && r.count >= 1 && r.until == null));
      }

      /**
       * A label template is another small closed vocabulary the client expands
       * without re-checking — the same argument as `validRecurrence` above, and
       * with a sharper edge: the thing that expands it is a kiosk on a shelf in
       * a lobby, and the person who would notice it misbehaving is not there.
       *
       * Only the vocabulary and the bounds are pinned. Per-line shape is not,
       * because the sanitizer in `lib/labelTemplate.ts` already reads a bad line
       * as no line, and rules cannot iterate a list to check each entry anyway.
       * What this stops is the shape that would make the *document* nonsense:
       * lines that are not a list, a copy count that is not a number, a
       * template with no lines at all — which should be written as `null`,
       * meaning "this gathering prints nothing", rather than as an empty one.
       */
      function validLabelTemplate(t) {
        return t is map
          && t.lines is list
          && t.lines.size() >= 1
          && t.lines.size() <= 6
          && t.copies is int
          && t.copies >= 1
          && t.copies <= 3;
      }

      /**
       * A reference to a chain: `seriesId`, `recurrenceRootId`,
       * `predictFromChain`.
       *
       * These are not ordinary strings. `chainKey()` picks one of them
       * (`src/lib/materialize.ts`) and the result becomes a *document id* — in
       * `skippedNights/{chainKey}`, in `eventAccess/{chainKey}`, and inside
       * these rules, where it is interpolated into a path to find the
       * gathering's access list. A value carrying a `/` would slice into a
       * different path than the one it names, and a non-string would not
       * interpolate at all.
       *
       * Both fail closed, so this is not a way in. It is a way to a
       * *self-inflicted outage*: one core member writing `seriesId: 42` in the
       * editor takes that gathering — and, once the ACL lookup depends on it,
       * its whole register — offline until somebody hand-repairs the document
       * in the console. The four timestamps below have always been validated
       * for the same reason. These never were.
       *
       * Kept to what a Firestore document id can actually be, minus the two
       * relative-path names, which are legal strings and illegal ids.
       */
      function validChainRef(v) {
        return v == null
          || (v is string
              && v.size() > 0
              && v.size() <= 200
              && !v.matches('.*/.*')
              && v != '.'
              && v != '..');
      }

      function validEvent() {
        let d = request.resource.data;
        let recurrence = d.get('recurrence', null);
        let labelTemplate = d.get('labelTemplate', null);
        return d.startAt is timestamp
          && d.endAt is timestamp
          && d.checkInOpensAt is timestamp
          && d.checkInClosesAt is timestamp
          && d.mode in ['recurring', 'oneoff']
          && (recurrence == null || validRecurrence(recurrence))
          && (labelTemplate == null || validLabelTemplate(labelTemplate))
          && validChainRef(d.get('seriesId', null))
          && validChainRef(d.get('recurrenceRootId', null))
          && validChainRef(d.get('predictFromChain', null));
      }

      allow get, list: if isActive();

      // Core and up only: moving an event's date mid-check-in would swap the
      // active event out from under every counselor's phone at once.
      /**
       * Both chains, and the second one is not paranoia.
       *
       * `buildEventPayload` nulls `seriesId` and `recurrenceRootId` when `mode`
       * becomes `'oneoff'` — a supported action in the event editor, not an
       * exotic attack. Without the second check, a core member outside a
       * restricted gathering could switch one of its instances to a one-off,
       * collapsing its `chainKey` to its own event id, for which no
       * `eventAccess` document exists — and the gathering plus its whole
       * register would be open. Editing `seriesId` to point at an open chain
       * does the same thing.
       *
       * On create, `resource` is null and there is no old chain to leave.
       */
      allow create: if isCore()
        && validEvent()
        && onChain(chainOfData(request.resource.data, eventId));

      allow update: if isCore()
        && validEvent()
        && onChain(chainOfData(resource.data, eventId))
        && onChain(chainOfData(request.resource.data, eventId));

      /**
       * Never from a client, even for the core team who may do everything else
       * here.
       *
       * Not because deleting a gathering is forbidden — the event page offers
       * it, and offers ending a whole repeat — but because deleting *this
       * document* is only half of it. The attendance and RSVPs underneath are a
       * subcollection, and a subcollection does not go with its parent: what
       * would be left is history no screen can reach and every collection-group
       * query still counts. Rules cannot enumerate a subcollection, so they
       * cannot make a client do the other half; what they can do is make sure
       * the request goes to the one place that does. See
       * `functions/src/eventDeletion.ts`.
       */
      allow delete: if false;

      match /attendance/{studentId} {
        /**
         * The doc id *is* the student id — that is what makes two counselors
         * tapping the same student converge on one record. Enforced here rather
         * than trusted to the client, because idempotency that depends on
         * well-behaved callers is not idempotency.
         */
        function validAttendance() {
          let d = request.resource.data;
          return d.studentId == studentId
            && d.eventId == eventId
            && d.checkedInBy == request.auth.uid
            && validArrival(d);
        }

        /**
         * `arrivalId` — who came through the door together.
         *
         * Optional: the main app writes one student at a time and makes no
         * claim about it, and every record predating the field has none. But
         * where it *is* written it decides which siblings a pickup screen
         * arrives pre-ticked for, so its shape is pinned here rather than
         * trusted to the one client that writes it. An opaque bounded string
         * and nothing else — a map or a list in this field would be a lobby
         * session smuggling structure into a read the next parent acts on.
         */
        function validArrival(d) {
          return !('arrivalId' in d)
            || (d.arrivalId is string && d.arrivalId.size() > 0 && d.arrivalId.size() <= 64);
        }

        /**
         * A student whose upstream record died is frozen: no check-in, no
         * un-check-in, no pickup, past events included, until somebody removes
         * them from the roster or re-creates the record. Named for the whole
         * document rather than for check-in, because it gates all three verbs
         * below — a pickup for a student the system of record no longer holds
         * is as unreconcilable as an arrival.
         *
         * The flag lives on the membership document and only the server writes
         * it, so this is not a client honour system — a stale tab back-filling
         * a deleted student into last month's gathering is refused by the
         * database. The `exists()` guard keeps the historical behaviour for a
         * student with no document yet: check-in is frequently what creates it.
         */
        function attendanceFrozen() {
          return exists(/databases/$(database)/documents/students/$(studentId))
            && get(/databases/$(database)/documents/students/$(studentId))
                 .data.get('upstreamRecordMissing', false) == true;
        }

        function checkOutKeys() { return ['checkedOutAt', 'checkedOutBy']; }

        /**
         * A pickup, recorded by whoever was at the door for it.
         *
         * Deliberately *not* gated on `validAttendance()`: that demands
         * `checkedInBy == request.auth.uid`, and the volunteer who takes a
         * child in is rarely the one who hands them back. Requiring it would
         * mean a shift change either fails or overwrites the provenance of the
         * check-in, which is the half of the audit that gets asked about.
         *
         * The rest of the record is a fact about the check-in and has to
         * survive being handed on, so this touches two fields and no others.
         * `touchesOnly` requires `resource != null`, so it can never create a
         * record either: a pickup for a child nobody checked in is a bug, not
         * a shortcut.
         *
         * The undo — both fields cleared — names nobody, which is why the
         * authorship check only applies when a time is being written.
         */
        function validCheckOut() {
          return touchesOnly(checkOutKeys())
            && (request.resource.data.get('checkedOutAt', null) == null
                || request.resource.data.checkedOutBy == request.auth.uid);
        }

        /**
         * What a lobby screen may do: record a pickup that has not been
         * recorded yet, and nothing else.
         *
         * Not an undo — the kiosk offers none, and a bystander clearing a
         * collection somebody witnessed is not a self-serve action. Not a
         * correction to a time already standing either; that is a staff
         * decision, made on the roster.
         */
        function kioskCheckOutAllowed() {
          return validCheckOut()
            && resource.data.get('checkedOutAt', null) == null
            && request.resource.data.get('checkedOutAt', null) != null;
        }

        /*
         * `onChain` never mentions `resource`, so it is constant with respect
         * to the result set and a `list` over this collection stays statically
         * satisfiable — `eventId` is bound by the query path. That property is
         * exactly what the collection-group wildcard does not have, which is
         * why the rule down there had to be denied outright instead.
         */
        allow get, list: if isActive() && onChain(eventChain(eventId));
        allow create: if isCounselor() && validAttendance() && !attendanceFrozen()
                      && onChain(eventChain(eventId));
        /**
         * A kiosk may add a record, and may record a first pickup. It may not
         * overwrite the moment and method a counselor recorded, and it may not
         * delete — an undo is nobody-at-a-kiosk's to perform. The client knows
         * this and renders an already-collected student as done rather than
         * re-writing them.
         */
        allow update: if isCounselor() && !attendanceFrozen()
                      && onChain(eventChain(eventId))
                      && (isKioskSession()
                            ? kioskCheckOutAllowed()
                            : (validAttendance() || validCheckOut()));
        allow delete: if isCounselor() && !attendanceFrozen() && !isKioskSession()
                      && onChain(eventChain(eventId));
      }

      /**
       * Who is expected on a one-off event.
       *
       * Core-only for every write. A counselor reads the list — with
       * `requiresRsvp` it is their roster — but who is on the trip is a decision
       * made before the door, not at it.
       */
      match /rsvps/{studentId} {
        function validRsvp() {
          let d = request.resource.data;
          return d.studentId == studentId && d.eventId == eventId;
        }

        allow get, list: if isActive() && onChain(eventChain(eventId));
        allow create, update: if isCore() && validRsvp() && onChain(eventChain(eventId));
        allow delete: if isCore() && onChain(eventChain(eventId));
      }
    }

    /* ---------------------------------------------------------------- */
    /* Reference data                                                    */
    /* ---------------------------------------------------------------- */

    match /eventSeries/{seriesId} {
      allow get, list: if isActive();
      allow write: if isCore();
    }

    /**
     * Which nights of a repeat chain nobody came to.
     *
     * Derived data, not a record: every claim in here can be re-derived by
     * reading the registers it summarises, and the app does exactly that for any
     * night the document does not cover. That is why a counselor may write it
     * where they may not write an event — nothing is entrusted to this document
     * that is not already theirs to see, and the worst a wrong entry can do is
     * cost the reads it was meant to save.
     *
     * Counselor rather than core because the writes happen where the work does:
     * at the door, when a night gains its first check-in and has to stop reading
     * as empty, and on a student's profile, when a year of nights is examined
     * for the first time. Both are counselor screens.
     *
     * `skipped` is only ever moved by `arrayUnion`/`arrayRemove`, never
     * rewritten, so two people examining and correcting at once cannot undo each
     * other. Rules cannot express "transform only", so this checks the shape and
     * leaves the atomicity to the callers — a client that rewrote the array
     * wholesale would still be writing something it is allowed to derive.
     *
     * Deletes are refused: forgetting the whole chain silently un-examines a
     * year, and the way to correct one night is to remove one night.
     */
    match /skippedNights/{chainKey} {
      function validSkippedNights() {
        let d = request.resource.data;
        return d.chainKey == chainKey
          && d.get('skipped', []) is list
          && d.updatedAt is timestamp
          && (!('examinedFrom' in d) || d.examinedFrom is timestamp);
      }

      // The chain *is* the document id here, so no event lookup is needed —
      // one billed read instead of two.
      allow get, list: if isActive() && onChain(chainKey);
      allow create, update: if isCounselor() && validSkippedNights() && onChain(chainKey);
      allow delete: if false;
    }

    /* ---------------------------------------------------------------- */
    /* eventAccess                                                       */
    /* ---------------------------------------------------------------- */

    /**
     * Who may work one gathering.
     *
     * The problem being solved is clutter, not secrecy: the Sunday-morning
     * nursery team's screen carries Friday's youth night, the retreat and the
     * Wednesday small group, none of which they will ever stand at. So what
     * closes is *working* the gathering — check-in, undo, RSVPs, the register,
     * editing. What stays open is that it exists, what it is called and when it
     * is on, because a counselor at a door at 6:59pm who sees an empty screen
     * concludes the app is broken and files check-ins against the wrong thing.
     *
     * Chain-keyed, like `skippedNights` above and for the same reason: most
     * occurrences are projected and have no document to hang an ACL on.
     *
     * **An absent document means the gathering is open.** Every rule that reads
     * this collection has to ask `exists()` before `get()`, because `get()` at
     * a path with no document raises rather than returning null — see
     * `firestore-tests/getSemantics.test.ts`. Written the obvious way, every
     * gathering nobody had restricted would have denied.
     *
     * This block governs the ACL itself. The gates that read it live on
     * `events`, `attendance`, `rsvps` and `skippedNights`.
     */
    match /eventAccess/{chainKey} {
      /**
       * The permission to change this document is the document.
       *
       * `resource`, not a lookup: what is being written *is* the access list,
       * so the stored version answers "may you touch this" directly. Reading it
       * through `get()` would be the same document at the cost of a billed
       * read, and would need the `exists()` dance besides.
       */
      function onThisChain() {
        return isAdmin()
          || resource.data.get('restricted', false) != true
          || request.auth.uid in resource.data.get('members', []);
      }

      /**
       * `members` is checked for shape and size but not element by element —
       * rules cannot iterate a list. A non-string in there is inert: it can
       * never equal `request.auth.uid`, so the worst it does is take up one of
       * the 200 slots. The cap is what actually matters, because this document
       * is read on every gated request and an unbounded array would make every
       * check-in pay for somebody's paste.
       */
      function validAccess() {
        let d = request.resource.data;
        return d.chainKey == chainKey
          && d.restricted is bool
          && d.members is list
          && d.members.size() <= 200
          && d.updatedAt is timestamp
          && d.updatedBy == request.auth.uid;
      }

      /**
       * No closing the door from the outside.
       *
       * The mistake this feature makes easiest is one core member restricting
       * *Friday Fellowship* — the gathering the whole ministry works — and
       * leaving themselves off it. Nobody could then re-open it, because
       * re-opening requires being on it. So the writer stays on the list.
       *
       * Admins are exempt: they pass `onThisChain()` regardless, so they are
       * never locking themselves out, and they may be tidying somebody else's
       * list on their behalf.
       */
      function writerStays() {
        return isAdmin() || request.auth.uid in request.resource.data.members;
      }

      /**
       * The permissive half, and the reason a counselor can be trusted with
       * it: Priya is already on Friday Fellowship, Jo turns up at the door, and
       * Priya adds her without finding an admin. Adding somebody to a gathering
       * you already work is not an escalation — it hands out exactly the access
       * you have.
       *
       * Removing somebody is not symmetric with adding them, so it is not here.
       * Nor is flipping `restricted`, which is a decision about the gathering
       * rather than about one person.
       */
      function onlyAdds() {
        return request.resource.data.members.hasAll(resource.data.get('members', []))
          && request.resource.data.restricted == resource.data.get('restricted', false);
      }

      /*
       * Readable to the whole team, which is what makes the locked screen able
       * to say "Miriam or Dana can add you" rather than just refusing. The
       * client pre-filters what it shows; this is not where the gathering is
       * protected.
       */
      allow get, list: if isActive();

      /*
       * The document only comes into existence by restricting something —
       * a fresh one saying `restricted: false` would be a no-op that costs a
       * read on every gated request forever. Re-opening is an update.
       */
      allow create: if isCore()
        && validAccess()
        && writerStays()
        && request.resource.data.restricted == true;

      allow update: if validAccess() && writerStays() && (
           isAdmin()
        || (isCore() && onThisChain())
        || (isCounselor() && onThisChain() && onlyAdds())
      );

      /*
       * Stated rather than left to the default deny at the bottom of the file,
       * because the distinction is load-bearing: writing `allow write:` in
       * place of `create, update:` would have silently handed over deletion,
       * and deleting this document re-opens the gathering to everybody. The way
       * to re-open is `restricted: false`, which keeps the list.
       */
      allow delete: if false;
    }

    /* ---------------------------------------------------------------- */
    /* config                                                            */
    /* ---------------------------------------------------------------- */

    match /config/settings {
      // The predictive window has to contain the threshold, or the roster's
      // "Recent" block can never be satisfied and silently renders empty.
      function validSettings() {
        let d = request.resource.data;
        return d.predictiveMinAttended is int
          && d.predictiveMinAttended >= 1
          && d.predictiveOfLastN is int
          && d.predictiveOfLastN >= d.predictiveMinAttended
          && d.miaConsecutiveMisses is int
          && d.miaConsecutiveMisses >= 1
          && d.newVisitorWindowDays is int
          && d.newVisitorWindowDays >= 1;
      }

      allow get: if isActive();
      allow write: if isCore() && validSettings();
    }

    /*
     * The non-secret half of the Planning Center configuration.
     *
     * This document is why a church can move its roster onto a different
     * Planning Center list without a deploy. The Personal Access Token is
     * deliberately not here and never will be: credentials live in Secret
     * Manager, where a browser cannot reach them even with an admin signed in.
     *
     * Read is core-only. Nothing on a counselor's screen depends on it — the
     * server resolves the configuration itself before answering any callable —
     * so there is no reason for a door volunteer's device to hold the shape of
     * the church's Planning Center account.
     */
    match /config/planningCenter {
      function validPcoConfig() {
        let d = request.resource.data;
        /*
         * A closed shape, unlike every other document in this file.
         *
         * The reason is specific: the one thing that must never appear here is
         * a Personal Access Token. Listing what is allowed — rather than
         * validating what is recognised and ignoring the rest — is what makes
         * "somebody stashed credentials in the config document" a write the
         * database refuses rather than a habit nobody notices.
         */
        return d.keys().hasOnly([
              'rosterSource', 'studentListId', 'counselorListId',
              'minGrade', 'maxGrade', 'writeBack',
              'cacheTtlSeconds', 'baseUrl', 'updatedAt', 'updatedBy',
            ])
          && (!('rosterSource' in d.keys()) || d.rosterSource in ['list', 'grade'])
          && (!('studentListId' in d.keys()) || d.studentListId is string)
          && (!('counselorListId' in d.keys()) || d.counselorListId is string)
          && (!('writeBack' in d.keys()) || d.writeBack in ['off', 'create', 'full'])
          && (!('minGrade' in d.keys()) || (d.minGrade is int && d.minGrade >= 0 && d.minGrade <= 12))
          && (!('maxGrade' in d.keys()) || (d.maxGrade is int && d.maxGrade >= 0 && d.maxGrade <= 12))
          && (!('minGrade' in d.keys()) || !('maxGrade' in d.keys()) || d.maxGrade >= d.minGrade)
          && (!('cacheTtlSeconds' in d.keys())
              || (d.cacheTtlSeconds is int && d.cacheTtlSeconds >= 0 && d.cacheTtlSeconds <= 300))
          && (!('baseUrl' in d.keys())
              || (d.baseUrl is string
                  && (d.baseUrl == '' || d.baseUrl.matches('https?://.*'))));
      }

      /**
       * The API root is the one field here that is not merely a preference.
       *
       * Every Planning Center request carries the church's Personal Access
       * Token, so whoever sets this address chooses where those credentials get
       * sent. That is an admin decision, not a core-team one — and the server
       * shows a standing "not the real Planning Center" warning whenever it is
       * set, so it cannot be changed quietly either.
       */
      function baseUrlUnchanged() {
        return resource == null
          ? request.resource.data.get('baseUrl', '') == ''
          : request.resource.data.get('baseUrl', '') == resource.data.get('baseUrl', '');
      }

      allow get: if isCore();
      allow write: if isCore() && validPcoConfig() && (isAdmin() || baseUrlUnchanged());
    }

    /**
     * The non-secret half of the Attendees (attendees32) configuration — the
     * `config/planningCenter` reasoning, applied to the second backend. The
     * DRF token is deliberately not here and never will be; the closed key
     * set is what makes stashing it a write the database refuses.
     */
    match /config/attendees32 {
      function validA32Config() {
        let d = request.resource.data;
        return d.keys().hasOnly([
              'enabled', 'baseUrl', 'divisionId', 'meetSlug', 'characterSlug',
              'assemblySlug', 'minGrade', 'maxGrade', 'writeBack',
              'cacheTtlSeconds', 'updatedAt', 'updatedBy',
            ])
          && (!('enabled' in d.keys()) || d.enabled is bool)
          && (!('divisionId' in d.keys()) || d.divisionId is string)
          && (!('meetSlug' in d.keys()) || d.meetSlug is string)
          && (!('characterSlug' in d.keys()) || d.characterSlug is string)
          && (!('assemblySlug' in d.keys()) || d.assemblySlug is string)
          && (!('writeBack' in d.keys()) || d.writeBack in ['off', 'create', 'full'])
          && (!('minGrade' in d.keys()) || (d.minGrade is int && d.minGrade >= 0 && d.minGrade <= 12))
          && (!('maxGrade' in d.keys()) || (d.maxGrade is int && d.maxGrade >= 0 && d.maxGrade <= 12))
          && (!('minGrade' in d.keys()) || !('maxGrade' in d.keys()) || d.maxGrade >= d.minGrade)
          && (!('cacheTtlSeconds' in d.keys())
              || (d.cacheTtlSeconds is int && d.cacheTtlSeconds >= 0 && d.cacheTtlSeconds <= 300))
          && (!('baseUrl' in d.keys())
              || (d.baseUrl is string
                  && (d.baseUrl == '' || d.baseUrl.matches('https?://.*'))));
      }

      /**
       * Same reasoning as the Planning Center `baseUrl`, with a sharper edge:
       * every Attendees request carries the integration token, so whoever
       * sets this address chooses where that credential gets sent. Admin
       * only.
       */
      function a32BaseUrlUnchanged() {
        return resource == null
          ? request.resource.data.get('baseUrl', '') == ''
          : request.resource.data.get('baseUrl', '') == resource.data.get('baseUrl', '');
      }

      allow get: if isCore();
      allow write: if isCore() && validA32Config() && (isAdmin() || a32BaseUrlUnchanged());
    }

    /**
     * Cross-backend settings — today, only which backend receives the
     * students Tally creates. Closed shape for the same reason as the
     * per-backend documents.
     */
    match /config/backends {
      function validBackendsConfig() {
        let d = request.resource.data;
        return d.keys().hasOnly(['defaultPushBackend', 'updatedAt', 'updatedBy'])
          && (!('defaultPushBackend' in d.keys()) || d.defaultPushBackend in ['pco', 'a32']);
      }

      allow get: if isCore();
      allow write: if isCore() && validBackendsConfig();
    }

    /*
     * `config/pcoSync` and `accessRoster` used to be matched here.
     *
     * Both are gone. `pcoSync` tracked a scheduled sweep that no longer exists;
     * `accessRoster` was a mirrored allowlist that `provisionAccess` now asks
     * Planning Center for directly, at the moment somebody signs in. Neither is
     * written any more, and the default-deny below covers anything that tries.
     */

    /* ---------------------------------------------------------------- */
    /* Kiosk                                                             */
    /* ---------------------------------------------------------------- */

    /**
     * The kiosk's search-by-phone index: `last4 -> student ids`, derived
     * server-side from the backends and rebuildable at any time. Only the
     * four digits are ever here — see docs/data-model.md. Readable by any
     * active member (the kiosk session is one); written only by the
     * functions, because a client that could write it could make any four
     * digits answer any student.
     */
    match /kioskIndex/{docId} {
      allow get: if isActive();
      allow list, write: if false;
    }

    /**
     * Pairing handshakes. Never a client's to touch in either direction:
     * the unauthenticated halves go through callables, the secret in here is
     * hashed, and a readable pairing document would let a bystander race the
     * kiosk for its token.
     */
    match /kioskPairings/{code} {
      allow read, write: if false;
    }

    /**
     * Self-registration claims — one document per run of the kiosk's
     * "first time here" wizard, so a retried call cannot create a second
     * family. Functions-only in both directions, like the pairings above.
     *
     * A client that could read them would learn which families registered
     * today and how many children each brought; a client that could write one
     * could pre-claim an id and make somebody's registration silently return
     * a stranger's students. Neither is anything a lobby screen needs — the
     * kiosk mints the id, sends it, and reads the answer.
     */
    match /kioskRegistrations/{registrationId} {
      allow read, write: if false;
    }

    /* ---------------------------------------------------------------- */
    /* One student's attendance, across every event                      */
    /* ---------------------------------------------------------------- */

    /**
     * A collection-group query over `attendance`, which is how a student's
     * page shows history older than the calendar the app keeps loaded.
     *
     * A collection-group query is only ever authorised by a rule at a wildcard
     * path — the nested `events/{eventId}/attendance/{studentId}` rule above
     * cannot grant it, however permissive it is — so this exists to make that
     * one query shape possible.
     *
     * It widens no data. Every document this can reach is already readable to
     * the same people through the nested rule, one event at a time; an active
     * member could already enumerate the lot by walking `events`. What changes
     * is the number of round trips it takes to ask "when did this student come",
     * which is the difference between a profile that can show two years of
     * history and one that stops at the loaded window.
     *
     * `list` only. A single document is fetched through its own path, and
     * writes stay where they are checked against the event they belong to —
     * `studentId == the document id`, `checkedInBy == the caller` — none of
     * which this wildcard could enforce.
     */
    match /{path=**}/attendance/{studentId} {
      allow list: if isActive();
    }

    /* ---------------------------------------------------------------- */
    /* Default deny                                                      */
    /* ---------------------------------------------------------------- */

    // Firestore already denies unmatched paths; this is here so that a future
    // collection added without a rule fails loudly in review rather than
    // quietly inheriting nothing.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
