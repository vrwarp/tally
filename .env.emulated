# Loaded by `vite --mode emulated` (npm run dev:emulated).
# Points the app at the local Firebase Emulator Suite — no real project needed.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-tally
VITE_EMULATOR_HOST=127.0.0.1
VITE_EMULATOR_AUTH_PORT=9099
VITE_EMULATOR_FIRESTORE_PORT=8080
VITE_EMULATOR_FUNCTIONS_PORT=5001
