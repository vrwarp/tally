# Planning Center settings for the *emulated* project, `demo-tally`.
#
# Committed on purpose. Every value here points at the local Planning Center
# simulator (`npm run pco-sim`, port 4010) and none of them is a credential —
# `demo-` project ids can only ever reach emulators, and the simulator accepts
# any Basic auth pair.
#
# It has to exist rather than being left to the environment because the Firebase
# CLI resolves `defineString`/`defineSecret` params from `.env.<project>` files
# when it *starts* the Functions emulator, before any function runs. With no file
# it stops and asks at the terminal — and an emulator sitting on a prompt loads
# no functions at all, so `provisionAccess` 404s and every sign-in dies on
# "Could not reach the access service". Non-interactively (CI, `emulators:exec`)
# there is nobody to answer, and the run just burns its timeout.
#
# `src/config.ts` still falls back to `process.env` for all of these, so an
# override passed to the emulator process — as `playwright.config.ts` does —
# continues to win at runtime.
#
# Its sibling `.secret.local.example` is the *other* local path: copy that one to
# `.secret.local` (gitignored) to point the same emulator at a real Planning
# Center account instead of the simulator. This file is the default; that one is
# for when you need your own church's data.

# The simulator, not Planning Center. `loadConfig` reports the override so a
# test rig can never be mistaken for production.
PCO_API_BASE_URL=http://127.0.0.1:4010/people/v2

# Who is on the roster is not configured here any more, and cannot be: it is
# Tally's own list, in `students/`. A Planning Center List is generated from
# filter rules, which is exactly what a hand-picked roster of teenagers is not.

# 6th through 12th grade, which is Footprints. Spelled out even though the code
# defaults to the same numbers: the CLI asks about every param it cannot find
# here, and one unanswered question stalls the whole emulator.
PCO_MIN_GRADE=6
PCO_MAX_GRADE=12

# Quick-added visitors get pushed upstream, which is what Journey 3 promises.
PCO_WRITE_BACK=create

# Short but non-zero, so local runs exercise the cache instead of routing round it.
PCO_CACHE_TTL_SECONDS=5

# Not credentials: the simulator ignores the values and only checks that a Basic
# auth header is present. Naming them here keeps the CLI from prompting for the
# two secret params on every emulator start.
PCO_APP_ID=sim-app-id
PCO_SECRET=sim-secret

# The bootstrap admin, and the answer to "who lets the first person in".
# Nobody can invite the first admin — there is nobody to do the inviting — so
# this list is a standing grant that the app itself cannot revoke.
TALLY_ADMIN_EMAILS=dana.ruiz@footprints.example.org
