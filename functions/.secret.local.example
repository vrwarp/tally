# Planning Center configuration for the local Functions emulator, against a
# **real** Planning Center account.
#
# Copy to `functions/.secret.local` (gitignored) and fill in. The Firebase
# emulator loads that file and binds each line to the matching `defineSecret` /
# `defineString` param in `functions/src/config.ts`, so `npm run dev:emulated`
# behaves like production.
#
# You probably do not need this file. The usual way to work on Tally locally is
# the bundled Planning Center simulator, which needs no account and no token:
#
#   npm run pco-sim        # in its own terminal, then `npm run seed`
#
# That path is already configured by the committed `functions/.env.demo-tally`,
# which the CLI loads for the emulator-only `demo-` project. Reach for
# `.secret.local` when you specifically need to see Tally against your church's
# own data — a roster that will not map, a custom field that will not resolve.
#
# The three files are read by different mechanisms and do not conflict:
#
#   functions/.env.demo-tally   committed, simulator settings, loaded by project id
#   functions/.secret.local     gitignored, your real token, loaded by the emulator
#   functions/.env.<projectId>  gitignored, per-deployment params (see the docs)
#
# In production none of these are used. The two secrets live in Secret Manager
# (`firebase functions:secrets:set PCO_APP_ID`) and the rest are deploy-time
# params (`firebase deploy` prompts for anything unset, or use `.env.<project>`).
#
# NEVER commit real values. `.secret.local` is in .gitignore for that reason.
#
# `functions/src/config.ts` is the source of truth for these names and defaults.
# Add a param there and add it here, or the next person copying this file gets a
# setting they cannot discover.


# ---------------------------------------------------------------------------
# API endpoint
# ---------------------------------------------------------------------------
# Where the Planning Center API lives. Leave blank for the real thing — which is
# the whole reason to be using this file rather than `.env.demo-tally`.
#
# `loadConfig` reports a non-empty value on the Settings screen, so a test rig is
# never mistaken for production.
PCO_API_BASE_URL=


# ---------------------------------------------------------------------------
# Credentials (secrets)
# ---------------------------------------------------------------------------
# Planning Center Personal Access Token. Sign in as a Planning Center account
# with People access, go to https://api.planningcenteronline.com/oauth/applications
# (Developer -> Personal Access Tokens -> "New Personal Access Token"), name it
# "Tally", and copy the two values it shows you exactly once.
#
# The token belongs to a *person*, and inherits that person's People permissions
# — so create it under an account that can read the youth roster and, if you
# enable write-back, edit people. Prefer a shared "office" account over a
# volunteer's personal login, otherwise Tally stops being able to read the
# roster the week they leave.
#
# The Application ID is sent as the HTTP Basic username.
PCO_APP_ID=

# The Secret is sent as the HTTP Basic password.
PCO_SECRET=


# ---------------------------------------------------------------------------
# Which people are "the Footprints roster" (params)
# ---------------------------------------------------------------------------
# 'list'  — the roster is a Planning Center List that the youth pastor curates.
#           This is what a real ministry does, because it survives grade edge
#           cases (a 5th grader who comes with a sibling, a graduated senior who
#           still leads worship).
# 'grade' — the roster is every child whose grade falls in PCO_MIN_GRADE..MAX.
#           Zero setup, but it silently misses anyone whose grade is blank.
PCO_ROSTER_SOURCE=grade

# Required when PCO_ROSTER_SOURCE=list. Open the list in Planning Center People
# (People -> Lists -> your list); the id is the number in the URL,
# e.g. https://people.planningcenteronline.com/lists/1234567 -> 1234567
PCO_STUDENT_LIST_ID=

# Optional. A second List holding the adult counselors and core team. Tally asks
# Planning Center who a person is at the moment they sign in, and this is the
# list it asks about — so anyone who needs to use Tally at all belongs on it.
# Leave blank to derive the team from the same read as the students (only useful
# in 'list' mode, since 'grade' mode queries children only).
PCO_COUNSELOR_LIST_ID=

# Grade band for the ministry. Footprints is 6th-12th.
PCO_MIN_GRADE=6
PCO_MAX_GRADE=12


# ---------------------------------------------------------------------------
# Write-back (param)
# ---------------------------------------------------------------------------
# How much Tally is allowed to change in the church's real people database.
# 'off'    — never write. Quick-added visitors stay flagged and someone types
#            them into Planning Center by hand.
# 'create' — create a Person for a quick-added visitor, nothing else. The safe
#            default: Tally adds, Planning Center still owns every edit.
# 'full'   — also push edits to managed fields (name, grade, gender, allergies)
#            back onto linked people.
PCO_WRITE_BACK=create


# ---------------------------------------------------------------------------
# Freshness (param)
# ---------------------------------------------------------------------------
# How long a Planning Center read may be reused, in seconds.
#
# Tally keeps no copy of the church's people: every roster and every profile is
# read from Planning Center when it is needed. This is the only thing standing
# between that design and eight identical roster pulls when eight counselors
# open the app in the same minute.
#
# 0 turns retention off entirely, which is a supported way to run — the app
# works, it just asks every time. Values above 300 are clamped to 300: beyond a
# couple of minutes this stops being a cache and starts being state, and a name
# corrected in Planning Center should show up on the next tap.
PCO_CACHE_TTL_SECONDS=30


# ---------------------------------------------------------------------------
# Small groups (param)
# ---------------------------------------------------------------------------
# Optional. Name or slug of a Planning Center custom field holding a person's
# small-group name (People -> Settings -> Custom Tabs & Fields). When set, a
# counselor's group comes back with their access check so Sunday School check-in
# opens pre-filtered. Leave blank if you assign groups inside Tally instead.
PCO_SMALL_GROUP_FIELD=
